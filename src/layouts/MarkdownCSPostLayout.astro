---
const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{frontmatter.title}</title>
    {frontmatter.desc && <meta name="description" content={frontmatter.desc} />}
    <style>
      body {
        background: #1a1a1a;
        background: linear-gradient(
          90deg,
          rgba(26, 26, 26, 1) 0%,
          rgba(51, 51, 51, 1) 100%
        );
        margin: 0;
      }

      main {
        height: fit-content;
        background-image: url("/images/image3.png");
      }
      article {
        max-width: 65vw;
        margin: 0 auto;
        font-size: 1rem;
        color: #e5e7eb;
        line-height: 1.625; /*  */
      }

      :global(header > .description) {
        font-size: 1.3rem;
      }
      :global(header > h1) {
        color: rgba(0, 255, 238, 1);
        margin: 0;
        padding: 0.5rem 0 0.5rem 0;
      }

      :global(section > h2, section > h3) {
        color: rgb(0, 255, 136);
        margin: 0;
        padding: 0.5rem 0 0.5rem 0;
      }

      :global(section > h1, section > h2, section > h3, section > p) {
      }

      :global(pre.astro-code) {
        border-radius: 12px;
        padding: 1.25rem 0.5rem 1.25rem 0.5rem;
        font-size: 0.8rem;
      }

      :global(.post-image) {
        margin: 2rem auto;
      }

      :global(.post-image.normal) {
        max-width: 100%;
      }

      :global(.post-image.wide) {
        max-width: 90vw;
      }

      :global(.post-image.full) {
        width: 100vw;
        margin-left: calc(50% - 50vw);
      }

      @media screen and (max-width: 720px) {
        article {
          max-width: 95vw;
          margin: 0 auto;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <article>
        <header>
          <h1>{frontmatter.title}</h1>
          {frontmatter.desc && <p class="description">{frontmatter.desc}</p>}
        </header>

        <section>
          <slot />
        </section>
      </article>
    </main>
  </body>
</html>
